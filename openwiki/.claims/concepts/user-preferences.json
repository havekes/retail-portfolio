          "version": "repo-lines-v1:sha256:5605e291c7a829c30512cf16516dd86ea42917bc679eca1ea23fe3bb554e73ae:"
        }
      ]
    },
    {
      "id": "claim_96269e4f4d6b49659de78187e1ee7280",
      "statement": "`UserPreferencesService` wraps `ApiClient` with `getPreferences`/`savePreferences` (PUT) and `patchPreferences` (PATCH) against `/accounts/me/preferences`; every method accepts an optional `tokenOverride` that adds an `Authorization: Bearer` header, which is how server-side loads authenticate instead of relying on the `auth_token` cookie.",
      "evidence": [
        {
          "resource": "repo://frontend/src/lib/api/apiClient.ts#L18-L24",
          "version": "repo-lines-v1:sha256:9041bc5e5fba5a5ad7e906a4279934be206f0876c10e1a166a40a35a034b4244:"
