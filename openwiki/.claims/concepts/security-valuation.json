    {
      "id": "claim_e529a99d925d418895c1674d4ad8e3b0",
      "statement": "`ValuationClient.getValuation` is the deliberate exception to the shared `ApiClient` rule that any non-`ok` response throws: it returns `Promise<SecurityValuation | null>` and maps a 404 to `null` through two branches -- an error whose `status` is 404, or an `Error` whose `message` includes `'404'` -- while rethrowing every other error; `saveValuation`/`setValuation` issue the `PUT` with exactly `{ lower_bound, upper_bound }` (silently dropping the interface's optional `notes` field, which the backend schema does not accept), and `getBatchValuations` short-circuits an empty id list to `[]` before POSTing `{ security_ids }`.",
      "evidence": [
        {
          "resource": "repo://frontend/src/lib/api/apiClient.ts#L39-L44",
          "version": "repo-lines-v1:sha256:008d6c2f4614a5323c312e02ef9c1280c3726e2f3dd591829157e64cc91b27cb:"
        },
        {
