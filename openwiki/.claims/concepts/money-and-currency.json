    {
      "id": "claim_5d75b9e4bc0d49f18ea6450b0f6cb2d1",
      "statement": "Holdings period math runs on JS `number`: `getBenchmarkPrice` returns the average cost for `period === 'ALL'` and otherwise the close of the most recent candle at or before the period cutoff (falling back to the earliest candle), and `calculateHoldingGain` returns `gainAmount = (currentPrice - benchmarkPrice) * quantity` and `gainPercent = priceDiff / benchmarkPrice * 100` guarded to `0` when the benchmark is `0`.",
      "evidence": [
        {
          "resource": "repo://frontend/src/lib/utils/finance/holdings-metrics.ts#L37-L160",
          "version": "repo-lines-v1:sha256:d56f7fd9219a353f70987833b209a28e3f076d308519ddbdb7e6e659be9bbed7:"
        }
      ]
    },
    {
      "id": "claim_a7fc6c2d99b04263ad53bbd890ca9314",
      "statement": "Precision is lost at defined storage boundaries: `PositionModel.quantity` is `DECIMAL(16, 8)` but `PositionModel.average_cost` is `Float`, `AccountModel.currency` is a plain `String` (while the API type is `Currency`), and `AccountModel.net_deposits` is `Float`.",
      "evidence": [
        {
          "resource": "repo://src/account/model.py#L210-L224",
