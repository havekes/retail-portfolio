    {
      "id": "claim_ee8804e187844bd9bca21588463bbe6b",
      "statement": "`_currency_convert` rounds each converted amount to 2 decimal places before accumulation, so aggregated totals are sums of rounded per-position values rather than the rounded sum of exact values; changing that rounding changes reported totals for multi-position accounts.",
