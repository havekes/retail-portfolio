    {
      "id": "claim_22a12249c41c4918a3b5f99c81b9c322",
      "statement": "`get_total_for_account` returns `AccountTotals(cost, value)` where `cost` is the sum of `quantity × average_cost` and `value` is the sum of `quantity × latest close`, each converted per position; this type is served by `GET /accounts/{account_id}/totals` and pushed over WebSocket as `AccountTotalsUpdatedMessage` by the `recalculate_all_account_totals_task` Huey task.",
      "evidence": [
