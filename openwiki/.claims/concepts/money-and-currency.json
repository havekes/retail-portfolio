        }
      ]
    },
    {
      "id": "claim_07a02410667d43e598ca1d78a849ba97",
      "statement": "`HoldingRead` reports the same logical amounts twice — native values in `security_currency` (`unconverted_total_value`, `latest_price`, `average_cost`, `unconverted_profit_loss`) and converted values in the account `currency` (`total_value`, `profit_loss`, `converted_average_cost`, `converted_latest_price`) — and the holdings table only prints the converted line when `holding.security_currency !== holding.currency`.",
      "evidence": [
