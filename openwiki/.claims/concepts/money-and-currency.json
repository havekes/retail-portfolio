    {
      "id": "claim_8619e0f3bc694e48808607937c19fee5",
      "statement": "`blendedAverageCost` computes the quantity-weighted mean of `average_cost` across holdings, returning `0` for an empty list, zero total quantity, or all-missing costs, and treating a missing `average_cost` as `0` so an unknown-cost holding pulls the blended figure toward zero rather than being excluded.",
      "evidence": [
        {
          "resource": "repo://frontend/src/lib/utils/finance/average-cost.test.ts#L4-L45",
          "version": "repo-lines-v1:sha256:7f9a8b0211d745247839a012c082689fabb5dec3b127c3de2918665611aa9fea:"
