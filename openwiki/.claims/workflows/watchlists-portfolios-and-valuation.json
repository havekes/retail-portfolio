    {
      "id": "claim_a14fc320e6ae4bff97bfd40bbf742841",
      "statement": "Because the ORM secondary relationship cannot carry or order by association columns, the watchlist repository loads memberships by explicitly querying the association table joined to securities ordered by position then added_at, and inserts membership rows explicitly (reloading with populate_existing) so position/added_at are written.",
