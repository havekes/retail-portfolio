        },
        {
          "resource": "repo://src/market/router.py#L963-L966",
          "version": "repo-lines-v1:sha256:e77d844d7513d75921c6223ce8395859d0178043b3dc3d49162799268f5fb44b:"
        }
      ]
    },
    {
      "id": "claim_f66d8f36d7e0436ba0983a8ecf0e5a38",
      "statement": "`generate_note_title` hard-codes `model=\"gpt-4-turbo\"` and ignores `settings.ai_api_model`, and uses `temperature=0.3`, `max_tokens=20`, `timeout=10` — parameters distinct from the 60-second analysis path.",
      "evidence": [
        {
          "resource": "repo://src/market/ai_service.py#L270-L301",
          "version": "repo-lines-v1:sha256:965ecc6c9dcf2caa77b1ed0297ea634512f725513b3f81621e666bc77bf5c7d1:"
