    {
      "id": "claim_2d9b4185918b4574bca76bec40c6ab79",
      "statement": "`generate_note_title` enforces `MAX_TITLE_LENGTH = 50` by slicing the result, strips matching surrounding double or single quotes, and swallows every exception to return a fallback derived from the note content (`content[:MAX_TITLE_LENGTH - 3] + \"...\"` for long content, else the raw content), which is why note creation can never fail because of the AI provider.",
      "evidence": [
        {
          "resource": "repo://src/market/ai_service.py#L21-L21",
          "version": "repo-lines-v1:sha256:206d9523bb5f0e78effe79fc4c6eb6ec801313f7d89ad409dbad31918d0fe6b3:"
        },
        {
