        }
      ]
    },
    {
      "id": "claim_580adb68bd1943dc9f41ec46f8dba891",
      "statement": "Note title generation is asynchronous: `market_create_note` and `market_update_note` persist the note and then enqueue `generate_note_title_task(note_id, request_id=get_request_id())`, returning the note before any title exists.",
      "evidence": [
        {
          "resource": "repo://src/market/router.py#L472-L510",
          "version": "repo-lines-v1:sha256:aef04cd848600c9955c1622e794d993eee5ec06d0f35bd80f492dbee92a22300:"
