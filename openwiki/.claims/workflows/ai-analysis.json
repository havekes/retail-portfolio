    {
      "id": "claim_48d4c7e294f14ee4b538211d40130ce5",
      "statement": "Stub versus real AI selection is a single switch: `register_services` branches on `settings.stub_external_api`, and when `STUB_EXTERNAL_API` is enabled `register_market_stub_services` registers `registry.register_factory(AIService, StubAIService)` instead of `ai_service_factory`.",
      "evidence": [
        {
          "resource": "repo://src/config/services.py#L116-L150",
