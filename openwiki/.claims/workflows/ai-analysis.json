        }
      ]
    },
    {
      "id": "claim_24c105513b534c1a8781b99ffb30494d",
      "statement": "`_generate_note_title` returns early when `huey.svcs_registry is None`, resolves `SecurityNoteRepository` and `AIService` from a `Container` built on that registry, warns and returns if the note id no longer exists, calls `ai_service.generate_note_title(note.content)`, writes the result via `note_repository.update_title(note_id, title)`, and restores the request-id context var token in a `finally` block.",
      "evidence": [
        {
          "resource": "repo://src/market/repository_sqlalchemy.py#L748-L756",
          "version": "repo-lines-v1:sha256:655dc7474bf4c44333280103650fe96fe2cbec3ab4232cbe87a50c0df4a1b5f5:"
        },
        {
