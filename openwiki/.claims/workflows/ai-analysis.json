        }
      ]
    },
    {
      "id": "claim_fcb6701e842d4294a1a8a7eacd7886ba",
      "statement": "The worker's `svcs` registry is built on `@huey.on_startup` in `setup_worker_services` with a `NullPool` session manager and the same `register_services` call used by the HTTP process, and Huey is `MemoryHuey` when `settings.environment == \"test\"` and `RedisHuey` otherwise.",
      "evidence": [
        {
          "resource": "repo://src/worker.py#L21-L51",
          "version": "repo-lines-v1:sha256:1a05a85165a15a37e49d4dc02ce8e190b321a7579d5a367027fcb1490c434025:"
        }
