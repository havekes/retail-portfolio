  "claims": [
    {
      "id": "claim_fc221626fd6b46c0894141fb25dcdb8a",
      "statement": "A portfolio is a user-owned named grouping of accounts, stored as `PortfolioModel` (id, user_id, name, timestamps) plus the `PortfolioAccountModel` join table whose composite primary key is `(portfolio_id, account_id)`; it stores no positions, and both FKs cascade `all, delete-orphan` from their parent relationships. The pair ships in `migrations/versions/7e1953e28527_add_portfoliomodel_and_.py` with a `UniqueConstraint('user_id', 'name')` on portfolios, and `deleted_at` exists on the model and migration but is never written because deletion is a hard ORM delete.",
      "evidence": [
