# Single source of configuration for the backend, worker, and Docker Compose dev stack.
# Copy to the repo root and start the stack:
#
#   cp .env.example .env && docker compose up -d
#
# Do not commit the resulting .env (it is gitignored); this example is.

ENVIRONMENT="dev"
# SECRET_KEY must be set and at least 32 characters long outside dev/test environments.
# The value below is a throwaway dev-only key. Generate a real one for any other
# environment with: openssl rand -hex 32 or python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="ad04d52ef3fc0729c5f216b0da80c1893e3d18959bf02d8c1c902fa0e00fe97f"
FRONTEND_URL="http://localhost:8002"

DATABASE_URL="postgresql+asyncpg://retail-portfolio-user:password@postgres:5432/retail-portfolio"
ECHO_SQL=false

CORS_ALLOW_ORIGINS="http://localhost:8101"
CORS_ALLOW_METHODS="*"
CORS_ALLOW_HEADERS="*"

# API keys
# FMP and POLYGON are required outside dev/test (unless STUB_EXTERNAL_API=true):
# the provider-agnostic data-plane gateway routes prices/fundamentals to FMP and
# options chains to Polygon.
EODHD_API_KEY="demo"
FMP_API_KEY="demo"
POLYGON_API_KEY="demo"
AI_API_ENDPOINT="https://ai.havek.es/api"
AI_API_KEY=""
AI_API_MODEL=""

# Shared secret for service-to-service data endpoints (MCP gateway -> backend).
# Must be identical on both sides: the backend compares the X-Service-Token
# header (src/auth/api.py::require_service_token) against this value, and the
# mcp-gateway sends it. Outside dev/test it must be a real generated secret
# (openssl rand -hex 32; enforced by src/config/settings.py::validate_service_token).
# STUB_EXTERNAL_API and the dev/test exemptions do NOT relax the gateway: stub
# mode only swaps the backend's provider adapters offline, while the backend data
# plane and the mcp-gateway still require the exact same non-empty secret. The
# value below is a throwaway dev-only default.
MARKET_DATA_SERVICE_TOKEN="dev-market-data-token"

# Redis
REDIS_URL="redis://redis:6379/0"

# Market gateway cache TTLs (seconds), per data class
GATEWAY_TTL_SEARCH_SECONDS=1209600
GATEWAY_TTL_PRICES_SECONDS=3600
GATEWAY_TTL_STATEMENTS_SECONDS=86400
GATEWAY_TTL_METRICS_SECONDS=86400
GATEWAY_TTL_OPTIONS_SECONDS=1800

# Indicator service sidecar
INDICATOR_SERVICE_URL="http://indicator-service:8080"

# MCP gateway (services/mcp-gateway): streamable-HTTP MCP server on the Compose
# internal network; /mcp is unauthenticated by design so NO host port is published.
BACKEND_BASE_URL="http://backend:8000"
MCP_GATEWAY_URL="http://mcp-gateway:8080"
# MCP_GATEWAY_PORT=8080    # container listen port override (compose env PORT)

# Email
SMTP_HOST="mailcrab"
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL="noreply@retail-portfolio.local"
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24

# Frontend (SvelteKit dev server in Docker; consumed by the frontend compose service)
VITE_API_BASE_URL="http://localhost:8001"
# Server-side rendering calls go over the compose network, not the host.
VITE_INTERNAL_API_URL="http://backend:8000"
VITE_ALLOWED_HOSTS="localhost"
# The SSR route guard (frontend/src/hooks.server.ts) verifies tokens the backend
# signs with SECRET_KEY (ARCH-T09). docker-compose.yml passes SECRET_KEY to the
# frontend service as JWT_SECRET, so no separate secret is configured here.

# Docker Compose interpolation (uncomment to override the defaults in docker-compose.yml)
# BACKEND_PORT=8001
# FRONTEND_PORT=8002
# BACKEND_DEBUG_PORT=8090
# WORKER_DEBUG_PORT=8091
# POSTGRES_PORT=5432
# MAILCRAB_PORT=8003
# INDICATOR_SERVICE_PORT=8085
# DOCKER_GID=959
