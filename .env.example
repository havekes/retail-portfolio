# Single source of configuration for the backend, worker, and Docker Compose dev stack.
# Copy to the repo root and start the stack

ENVIRONMENT="dev"
# SECRET_KEY must be set and at least 32 characters long outside dev/test environments.
# The value below is a throwaway dev-only key. Generate a real one for any other
# environment with: openssl rand -hex 32
SECRET_KEY="ad04d52ef3fc0729c5f216b0da80c1893e3d18959bf02d8c1c902fa0e00fe97f"
FRONTEND_URL="http://localhost:8002"

DATABASE_URL="postgresql+asyncpg://retail-portfolio-user:password@postgres:5432/retail-portfolio"
ECHO_SQL=false

CORS_ALLOW_ORIGINS="http://localhost:8101"
CORS_ALLOW_METHODS="*"
CORS_ALLOW_HEADERS="*"

# API keys
# FMP and POLYGON are required outside dev/test (unless STUB_EXTERNAL_API=true):
# the provider-agnostic data-plane gateway routes prices/fundamentals to FMP and
# options chains to Polygon.
EODHD_API_KEY="demo"
FMP_API_KEY="demo"
POLYGON_API_KEY="demo"
AI_API_ENDPOINT="https://ai.havek.es/api"
AI_API_KEY=""
AI_API_MODEL=""

# Shared secret for service-to-service data endpoints (MCP gateway -> backend)
MARKET_DATA_SERVICE_TOKEN="dev-market-data-token"
DATA_PLANE_PATH="/api/v1/market/data"

# Redis
REDIS_URL="redis://redis:6379/0"

# Services URLs
BACKEND_BASE_URL="http://backend:8000"
INDICATOR_SERVICE_URL="http://indicator-service:8080"
MCP_GATEWAY_URL="http://mcp-gateway:8080"

# Email
SMTP_HOST="mailcrab"
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL="noreply@retail-portfolio.local"
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24

# Frontend
VITE_API_BASE_URL="http://localhost:8001"
# Server-side rendering calls go over the compose network, not the host.
VITE_INTERNAL_API_URL="http://backend:8000"
VITE_ALLOWED_HOSTS="localhost"

# Docker Compose interpolation (uncomment to override the defaults in docker-compose.yml)
# BACKEND_PORT=8001
# FRONTEND_PORT=8002
# BACKEND_DEBUG_PORT=8090
# WORKER_DEBUG_PORT=8091
# WORKER_METRICS_PORT=8006
# POSTGRES_PORT=5432
# MAILCRAB_PORT=8003
# INDICATOR_SERVICE_PORT=8004
# MCP_GATEWAY_PORT=8005
# DOCKER_GID=959
# Observability overlay ports (docker-compose.observability.yml)
# Images pinned: clickhouse/clickstack-all-in-one:2.39.1,
# otel/opentelemetry-collector-contrib:0.161.0 (tail-sampling gateway),
# prom/prometheus:v3.13.4
# CLICKSTACK_UI_PORT=8080
# External URL for HyperDX UI login redirect/CORS (e.g. http://<server-ip>:8080)
# CLICKSTACK_FRONTEND_URL=http://localhost:8080
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318
# OTEL_COLLECTOR_METRICS_PORT=8888
# PROMETHEUS_PORT=9090

# OpenTelemetry exporter configuration (F-OBS-T02+)
# Services address the collector over the compose network. With the observability
# overlay the default is the F-OBS-T16 tail-sampling gateway
# (http://otel-sampler:4318); set OTEL_EXPORTER_OTLP_ENDPOINT to
# http://clickstack:4318 to bypass sampling for raw debugging.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-sampler:4318
# Team ingestion API key from HyperDX (Team Settings -> API Keys). Required by
# the gateway's ClickStack exporter; without it the sampler still starts, but
# ClickStack rejects the batches.
# HYPERDX_API_KEY=
# Percentage of the successful bulk retained by the tail-sampling policy.
# Configured band: 5-10 (docker/observability/README.md § Tail Sampling Policy).
# OTEL_SAMPLER_SUCCESS_PERCENT=7
# Legacy per-service OTLP header passthrough (apps forward it to whatever
# endpoint they are pointed at; with the overlay the gateway adds the API key).
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
# OTEL_SDK_DISABLED=false
# DEPLOY_ID=dev
